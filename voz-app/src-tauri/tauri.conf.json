{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voz",
  "version": "0.2.0",
  "identifier": "com.ulahanna.voz",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Voz",
        "width": 400,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": ["pipewire", "xdg-utils"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["icons/tray-idle.png", "icons/tray-rec.png", "icons/tray-proc.png"],
    "category": "Utility",
    "shortDescription": "Local recorder + transcriber",
    "longDescription": "Record mic and/or system audio, transcribe locally with Whisper, and save Raw + Refined notes to your Obsidian vault."
  }
}
