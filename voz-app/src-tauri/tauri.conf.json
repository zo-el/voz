{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voz",
  "version": "0.1.0",
  "identifier": "com.ulahanna.voz",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "title": "Voz",
        "width": 400,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; connect-src 'self'",
      "capabilities": ["panel-capability"]
    },
    "trayIcon": {
      "id": "voz-tray",
      "iconPath": "icons/tray-idle.png",
      "tooltip": "Voz"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Local recorder + transcriber",
    "longDescription": "Record mic and/or system audio, transcribe locally with Whisper, and save Raw + Refined notes to your Obsidian vault."
  }
}
